# --- STRIPE ---
# Dashboard Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Dashboard Stripe -> Developers -> Webhooks -> (po dodaniu endpointu) -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Adres, na który Stripe ma przekierować po udanej/nieudanej płatności
SUCCESS_URL=https://twoja-domena.pl/dziekujemy.html
CANCEL_URL=https://twoja-domena.pl/index.html

# --- COMARCH BETTERFLY ---
# Wygenerowany w panelu Betterfly: Ustawienia -> API
COMARCH_API_BASE=https://app.comarchbetterfly.pl/api2/public/v1.5
COMARCH_API_TOKEN=wklej_tu_token_z_panelu_betterfly

# ID produktu/usługi w Twoim katalogu Betterfly, np. "Transfer lotniskowy"
# (Ustawienia -> Produkty i usługi -> otwórz usługę -> ID w adresie URL)
COMARCH_PRODUCT_ID=wklej_id_produktu

# ID formy płatności "Płatność online" zdefiniowanej w Betterfly
# (Ustawienia -> Formy płatności)
COMARCH_PAYMENT_TYPE_ID=wklej_id_formy_platnosci

# --- OPCJONALNIE: zapis do Kalendarza Google (z wcześniej skonfigurowanego Apps Script) ---
CALENDAR_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Port serwera (Render/Railway ustawiają to automatycznie, zwykle nie trzeba zmieniać)
PORT=3000
